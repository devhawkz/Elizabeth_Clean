{% assign main_menu_linklist = linklists[section.settings.menu].links %}
{% assign middle_index = main_menu_linklist.size | divided_by: 2 | ceil %}

<div class="bg-white" x-data="{ mobileMenuOpen: false }" style="background-color: {{ section.settings.header_background_color }};">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-3 items-center h-20">
      <div class="-mr-2 -my-2 ml-3 md:hidden">
        <button x-on:click="mobileMenuOpen = !mobileMenuOpen" type="button" class="bg-white p-2 inline-flex items-center justify-center focus:outline-none">
            {% render 'icon-hamburger' %}
        </button>
      </div>

      <!-- LEFT: Search -->
      <div class="flex justify-start items-center hidden md:block" > 
        <button aria-label="Search" class="hover:text-black" style="color: {{ section.settings.font_color }};">
          {% render 'icon-search' %}
        </button>
      </div>

      <!-- CENTER: Navigation -->
      <div class="flex items-center justify-center space-x-12">
        <!-- Left-side nav items -->
        <nav class="hidden md:flex space-x-6 text-sm font-medium text-gray-900" style="color: {{ section.settings.font_color }};">
        
          {% for link in main_menu_linklist %}
            {% if forloop.index <= middle_index %}
                <a href="{{ link.url }}" class="hover:text-gray-600 uppercase tracking-wide">
                    {{ link.title }}
                </a>
              {% endif %}
          {% endfor %}
        </nav>
        
        <a href="{{ routes.root_url }}" class="hidden md:flex">
          {% if section.settings.logo %}
            <img src="{{ section.settings.logo | image_url }}" alt="Logo" class="h-10 w-auto" />
          {% else %}
            <img src="{{ 'weeklyhow-logo.png' | asset_url }}" alt="Logo" class="h-10 w-auto" />
          {% endif %}
          </a>
        <!-- Right-side nav items -->
        <nav class="hidden md:flex space-x-6 text-sm font-medium text-gray-900" style="color: {{ section.settings.font_color }};>
            {% for link in main_menu_linklist %}
                {% if forloop.index  > middle_index %}
                     <a href="{{ link.url }}" class="hover:text-gray-600 uppercase tracking-wide">
                         {{ link.title }}
                     </a>
                 {% endif %}
               {% endfor %}
        </nav>
      </div>
      
      <!-- RIGHT: Account + Cart -->
      <div x-data="{open: false}" class="flex justify-end items-center space-x-4 relative">
        {% if shop.customer_accounts_enabled %}
            <button x-on:click="open = !open" class="inline-flex items-center hover:text-gray-900" style="color: {{ section.settings.font_color }};">
                {% render 'icon-user' %}
            </button>    
            <div x-show="open" @click.away="open = false" class="absolute z-10 mt-30  w-20 h-20 bg-white shadow-lg rounded-lg">
                <div class="flex flex-col items-center justify-center gap-2 p-2" >
                    
                        <a href="{{ routes.account_login_url }}" class="-m-3 p-3 flex items start rounded-lg hover:underline" >Login</a><hr/>
                        <a href="{{ routes.account_register_url }}" class="-m-3 p-3 flex items start rounded-lg hover:underline">Register</a>
                    
                </div>
            </div>      
        {% endif %}
        <a href="{{ routes.cart_url }}" aria-label="Cart" class=" hover:text-black" style="color: {{ section.settings.font_color }};">
          {% render 'icon-cart' %}
        </a>
      </div>

    </div>

      <!-- MOBILE MENU CONTAINER -->

    <div x-show="mobileMenuOpen" class="absolute z-10 top-0 inset-x-0 p-2 transform origin-top-left md:hidden">
      <div class="shadow-lg rounded-lg ring-1 ring-black ring-opacity-5 bg-white w-full">
         <div class="p-5 divide-y-2 divide-gray-50">
   
             <!-- MOBILE MENU HEADER TITLE PLUS CLOSE BUTTON -->
             <div class="flex items-center justify-between pb-3">
                 <div>
                     <h1 class="text-lg text-gray-500">{{ section.settings.mobile_menu_title }}</h1>
                 </div>
                 <div class="-mr-2">
                     <button x-on:click="mobileMenuOpen = false" type="button" class="bg-white rounded-md p-2 text-gray-500">  
                      {% render 'icon-close' %}
                     </button>
                 </div>
             </div>
   
             <!-- NAVIGATION LINKS FOR MOBILE MENU -->
             <div class="pt-3">
               <nav class="grid gap-y-7">
                   {%  for link in main_menu_linklist %}
                     {% assign link_handle = link.handle |  replace: '-', '_'%}
                     {% if link.links != blank %}
                     <div x-data="{ {{ link_handle }}: false }" class="relative">
                       <button x-on:click=" {{ link_handle }} = !{{ link_handle }}" type="button" class="text-base text-gray-500 hover:text-gray-900 flex items-center justify-between w-full">
                           <div>{{ link.title }}</div>
                           {% render 'icon-dropdown' %}
                       </button>
                       <div x-show="{{ link_handle }}" class="grid gap-y-7 py-3">
                         {% for childlink in link.links %}
                           <a href="{{ childlink.url }}" class="-m-3 p-3 mt-2 flex items-center rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50">
                               <span class="ml-3 text-base font-medium text-gray-500">{{  childlink.title }}</span>
                           </a>
                         {% endfor %}
                       </div>   
                     </div>
                   {% else %}
                     <a href="#" class="-m-3 p-3 flex items-center rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50">
                       {{ link.title }}
                     </a>
                   {% endif %}
                 {% endfor %}
                     
               </nav>
             </div>
         </div>
       </div>
     </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "mobile_menu_title",
      "label": "Title",
      "default": "Menu",
      "info": "This is the title of the mobile menu window"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header Menu",
      "default": "main-menu"
    },
    {
      "type":"color",
      "id": "header_background_color",
      "label": "Background color",
      "default": "#ffffff",
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font color",
      "default": "#000000"
    },
    {
      "type":"image_picker",
      "id": "logo",
      "label": "Logo image"
    }
  ]
}
{% endschema %}
