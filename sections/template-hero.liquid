
    
      <section class="relative bg-gray-200 flex items-center justify-center px-6 py-16 group" style="background-color:{{ section.settings.bg_color }}">
        <div class="max-w-6xl w-full flex flex-col md:flex-row items-center justify-between">
          
          <!-- Image Placeholder -->
          <div class="w-full md:w-1/2 flex justify-center mb-10 md:mb-0">
            <div class="bg-gray-300 w-80 h-[480px] transform transition duration-300 hover:scale-105 hover:shadow-xl">
               {% if section.settings.featured_image %}
                    <img src="{{ section.settings.featured_image | image_url }}" alt="featured product" class="w-full h-full object-cover rounded-lg" />
                {% else %}
                    <img src="{{ 'pexels-karolina-grabowska-5398874.jpg' | asset_url }}" alt="featured product" class="w-full h-full objext-cover rounded-lg" />
                {% endif %}
            </div>
          </div>
    
          <!-- Text Content -->
          <div class="w-full md:w-1/2 text-center md:text-left relative z-10 transition duration-300 group-hover:-translate-y-1">
            <h1 class="text-4xl md:text-5xl font-bold leading-tight" style="color:{{ section.settings.heading_color }};">
             {{ section.settings.heading }}
            </h1>
            <p class="mt-4 text-lg" style="color:{{ section.settings.subheading_color }};">
              {{ section.settings.subheading }}
            </p>
            <div class="mt-8">
              <a href="{{ section.settings.button_link }}" class="font-bold py-3 px-6 hover:bg-gray-800 hover:scale-105 transition transform duration-300 inline-block" style="background-color:{{ section.settings.bg_button_color }}; color:{{ section.settings.button_text_color }};" > 
                {{ section.settings.button_text }}
              </a>
            </div>
          </div>
        </div>
    
        <!-- Triangle Shape at Bottom -->
        <div class="absolute bottom-0 left-[90%] transform -translate-x-1/2
            w-0 h-0 
                    
            border-l-[300px] border-l-transparent 
            border-r-[300px] border-r-transparent 
            border-b-[100px] border-b-white">
        </div>
      </section>

      {% schema %}
      {
        "name": "Hero with Product",
        "settings": [
          {
            "type":"image_picker",
            "id": "featured_image",
            "label": "Featured product image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Title",
            "default": "Mushrooms That Do More For You"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subtitle",
            "default": "Premium Powerful And Energetic Mushrooms Supplements Made Right"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button URL",
            "default": "/collections/all"
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "Button text",
            "default": "Shop now"
          },
          {
            "type": "color",
            "id": "bg_color",
            "label": "Card backgorund color"
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading text color",
            "default": "#4a4848"
          },
          {
            "type": "color",
            "id": "subheading_color",
            "label": "Subheading text color",
            "default": "#636261"
          },
          {
            "type": "color",
            "id": "bg_button_color",
            "label": "Button background color",
            "default": "#636261"
          },
          {
            "type": "color",
            "id": "button_text_color",
            "label": "Button text color",
            "default": "#ffffff"
          },
        ],
        "presets": [
          {
            "name": "Hero section with product"
          }
        ]
      }
      {% endschema %}
      