
    
      <section class="relative flex items-center bg-gray-200 justify-center px-6 py-16 group" style="background-color:{{ section.settings.bg_color }}">
        <div class="max-w-6xl w-full flex flex-col md:flex-row items-center justify-between">
          {% for block in section.blocks %}
            {% assign product = all_products[block.settings.product] %}
              {% if product %} 
              <div class="w-full md:w-1/2 flex justify-center mb-10 md:mb-0">
                  <div class="bg-gray-300 w-80 h-[480px] transform transition duration-300 hover:scale-105 hover:shadow-xl">
                     {% if product.featured_image %}
                          <img src="{{ product.featured_image | image_url }}" alt="{{product.title}}" class="w-full h-full object-cover rounded-lg" />
                      {% else %}
                          <img src="{{ 'pexels-karolina-grabowska-5398874.jpg' | asset_url }}" alt="featured product" class="w-full h-full objext-cover rounded-lg" />
                      {% endif %}
                  </div>
                </div>
                <div class="w-full md:w-1/2 text-center md:text-left relative z-10 transition duration-300 group-hover:-translate-y-1"> 
                    <h1 class="text-4xl md:text-5xl font-bold leading-tight">
                      {{ product.title }}
                    </h1>
                    <p class="mt-4 text-lg">
                      {{ product.description }}
                    </p>   
                  <div class="mt-8">
                    <a href="{{ product.url }}" class="font-bold py-3 px-6 hover:bg-gray-800 hover:scale-105 transition transform duration-300 inline-block" style="background-color:{{ section.settings.bg_button_color }}; color:{{ section.settings.button_text_color }};" > 
                      {{ section.settings.button_text }}
                  </a>
                </div>
                </div>
               {% endif %}   
                  
             
                 
          {% endfor %}
        </div>
    
        <!-- Trougao -->
        <div class="hidden md:block">
          <div class="absolute bottom-0 left-[90%] transform -translate-x-1/2
            w-0 h-0 
                    
            border-l-[300px] border-l-transparent 
            border-r-[300px] border-r-transparent 
            border-b-[100px] border-b-white">
          </div>
        </div>
      </section>

      {% schema %}
      {
        "name": "Hero with Product",
        "settings": [
          {
            "type": "text",
            "id": "button_text",
            "label": "Button text",
            "default": "Shop now"
          },
          {
            "type": "color",
            "id": "bg_color",
            "label": "Card backgorund color"
          },
          {
            "type": "color",
            "id": "bg_button_color",
            "label": "Button background color",
            "default": "#636261"
          },
          {
            "type": "color",
            "id": "button_text_color",
            "label": "Button text color",
            "default": "#ffffff"
          },
        ],
        "presets": [
          {
            "name": "Hero section with product"
          }
        ],
        "max_blocks": 1,
        "blocks": [
            {
                "type": "product",
                "name": "Product",
                "settings": [
                  {
                    "type": "product",
                    "id": "product",
                    "label": "Featured product"
                  },
                  {
                    "type": "color",
                    "id": "heading_color",
                    "label": "Heading text color",
                    "default": "#4a4848"
                  },
                  {
                    "type": "color",
                    "id": "subheading_color",
                    "label": "Subheading text color",
                    "default": "#636261"
                  }
                ]
            }
            
        ]
      }
      {% endschema %}
      