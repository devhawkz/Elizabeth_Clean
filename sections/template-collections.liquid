<section class="py-10 px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 sm:mb-10">Collections</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        {% if product %}
          <div class="flex flex-col items-center text-center" {{ block.shopify_attributes }}>
            <div class="w-full h-[280px] sm:h-[320px] lg:h-[400px] bg-gray-200 overflow-hidden rounded">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | img_url: '500x' }}"
                    alt="{{ product.title }}"
                    class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                  >
                {% else %}
                  <img
                    src="{{ 'placeholder.jpg' | asset_url }}"
                    alt="Placeholder image"
                    class="w-full h-full object-cover opacity-50"
                  >
                {% endif %}
              </a>
            </div>
            <p class="mt-3 text-sm sm:text-base tracking-widest text-gray-600 uppercase">{{ product.title }}</p>
            <p class="text-black font-semibold sm:font-bold mt-1">{{ product.price | money_with_currency }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  
  

{% schema %}
{
    "name":"Product Collections",
    "max_blocks":4,
    "settings": [
        {
            "type":"text",
            "id":"section_title",
            "label": "Section Title",
            "default": "Collections"
        }
    ],
    "blocks": [
        {
            "type": "product",
            "name": "Product",
            "settings":[
            {
                "type":"product",
                "id":"product",
                "label":"Choose a product"
            }
          ],
        }
    ],
    "presets": [
        {
            "name": "Products Highlights",
            "category": "Products"
        }
    ]
}
{% endschema %}